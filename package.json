{
  "name": "hardcover-oauth-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Remote MCP server for Hardcover.app with OAuth, running on Cloudflare Workers",
  "type": "module",
  "imports": {
    "#root/*": "./*",
    "#src/*": "./src/*",
    "#test/*": "./test/*"
  },
  "scripts": {
    "prepare": "effect-tsgo patch --no-typescript --oxlint"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.3",
    "effect": "4.0.5",
    "graphql": "^17.0.2",
    "match-sorter": "8.3.0",
    "minisearch": "7.2.0"
  },
  "devDependencies": {
    "@astrojs/markdown-satteri": "0.4.4",
    "@cloudflare/workers-types": "^5.20261018.1",
    "@effect/platform-bun": "^4.0.5",
    "@effect/platform-node": "^4.0.5",
    "@effect/tsgo": "0.53.4",
    "@types/bun": "^1.4.3",
    "alchemy": "2.0.0-beta.83",
    "astro": "7.4.0",
    "github-slugger": "2.0.0",
    "knip": "6.41.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "satteri": "0.10.5",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@hono/node-server": "1.19.17",
    "hono": "4.13.13",
    "lodash": "4.18.1",
    "valibot": "1.5.0"
  }
}
