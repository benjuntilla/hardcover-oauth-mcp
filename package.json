{
  "name": "hardcover-oauth-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Remote MCP server for Hardcover. Lets Claude, ChatGPT, and other AI assistants manage your books, reading progress, reviews, lists, and goals. Sign in with Hardcover OAuth, no API key needed. Hosted or self-hosted on Cloudflare Workers.",
  "type": "module",
  "imports": {
    "#root/*": "./*",
    "#src/*": "./src/*",
    "#test/*": "./test/*"
  },
  "scripts": {
    "prepare": "effect-tsgo patch --no-typescript --oxlint"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@hardcover/sdk": "0.1.1",
    "effect": "4.1.1",
    "graphql": "^17.0.2",
    "match-sorter": "8.3.0",
    "minisearch": "7.2.0"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.85",
    "@astrojs/markdown-satteri": "0.4.6",
    "@cloudflare/workers-types": "^5.20261018.1",
    "@effect/platform-bun": "^4.1.1",
    "@effect/platform-node": "^4.1.1",
    "@effect/tsgo": "0.63.0",
    "@ibm/plex-mono": "2.5.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/bun": "^1.4.3",
    "@types/three": "0.187.0",
    "alchemy": "2.0.0-beta.85",
    "astro": "7.4.4",
    "charter-webfont": "4.1.0",
    "github-slugger": "2.0.0",
    "hersheytext": "2.0.0",
    "knip": "6.44.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "satteri": "0.10.5",
    "three": "0.187.0",
    "typescript": "7.0.2",
    "woff2-encoder": "2.0.0"
  },
  "overrides": {
    "@hono/node-server": "2.1.5",
    "hono": "4.13.14",
    "lodash": "4.18.1",
    "valibot": "1.5.0"
  }
}
