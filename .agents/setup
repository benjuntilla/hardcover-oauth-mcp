#!/usr/bin/env bash
# Orb/CI setup: install mise and the project's toolchain and dependencies.
set -euo pipefail
MISE_VERSION=2026.10.8
mise_bin="$HOME/.local/bin/mise"
if ! command -v mise >/dev/null 2>&1 && [ ! -x "$mise_bin" ]; then
  # Hashes from the release's SHASUMS256.txt, so a tampered download fails here instead of running.
  case "$(uname -sm)" in
    "Linux x86_64") platform=linux-x64 sha256=c72477ae6c3a8e7d817a322f43da70e4643e75ee5c21265f1c19c894273b7428 ;;
    "Linux aarch64") platform=linux-arm64 sha256=6ee0bd8173f1347514f4974d55fb1fae13aa7f6de0a55338adbefa0667cad7e5 ;;
    "Darwin arm64") platform=macos-arm64 sha256=dd77de9a7574e38d8409fb06fa85e1581415896639d075987791d8c4e5a57b73 ;;
    *) echo "No pinned mise build for $(uname -sm)" >&2; exit 1 ;;
  esac
  download="$(mktemp)"
  curl -fsSL -o "$download" "https://github.com/jdx/mise/releases/download/v${MISE_VERSION}/mise-v${MISE_VERSION}-${platform}"
  echo "${sha256}  ${download}" | shasum -a 256 --check --status
  mkdir -p "$(dirname "$mise_bin")"
  install -m 755 "$download" "$mise_bin"
  rm -f "$download"
fi
export PATH="$HOME/.local/bin:$PATH"
mise trust --yes .
mise install
mise run install
